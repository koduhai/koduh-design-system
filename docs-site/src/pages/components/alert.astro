---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Playground from '../../components/playground/Playground';
import AlertDemo from '../../components/demos/AlertDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Alert" description="`role=&quot;alert&quot;`/`role=&quot;status&quot;`, `dismissable`">
  <p class="doc-eyebrow">Data display &amp; feedback</p>
  <h1>Alert</h1>
  <p class="doc-lede"><code>role="alert"</code>/<code>role="status"</code>, <code>dismissable</code>.</p>

  <h2>Playground</h2>
  <Playground client:visible name="Alert" />

  <h2>Examples</h2>
  <AlertDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; Alert &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <table class="doc-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>severity</code></td>
        <td><code>AlertSeverity</code></td>
        <td><em>required</em></td>
        <td>Semantic severity. Drives color, default icon, and ARIA role.</td>
      </tr>
      <tr>
        <td><code>title</code></td>
        <td><code>ReactNode</code></td>
        <td>—</td>
        <td>Optional bold heading shown above the body.</td>
      </tr>
      <tr>
        <td><code>dismissable</code></td>
        <td><code>boolean</code></td>
        <td>—</td>
        <td>When true, shows a labeled dismiss button.</td>
      </tr>
      <tr>
        <td><code>onClose</code></td>
        <td><code>() =&gt; void</code></td>
        <td>—</td>
        <td>Called when the dismiss button is clicked.</td>
      </tr>
      <tr>
        <td><code>closeLabel</code></td>
        <td><code>string</code></td>
        <td><code>the i18n catalog's `dismiss` ('Dismiss')</code></td>
        <td>Accessible label for the dismiss button.</td>
      </tr>
      <tr>
        <td><code>icon</code></td>
        <td><code>ReactNode</code></td>
        <td>—</td>
        <td>Custom leading icon. Overrides the severity default.
Pass a falsy value (e.g. <code>null</code>) to disable the icon entirely.</td>
      </tr>
    </tbody>
  </table>
</BaseLayout>
