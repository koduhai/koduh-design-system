---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Playground from '../../components/playground/Playground';
import AvatarDemo from '../../components/demos/AvatarDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Avatar" description="image + initials fallback, sizes/shapes">
  <p class="doc-eyebrow">Data display &amp; feedback</p>
  <h1>Avatar</h1>
  <p class="doc-lede">image + initials fallback, sizes/shapes.</p>

  <h2>Playground</h2>
  <Playground client:visible name="Avatar" />

  <h2>Examples</h2>
  <AvatarDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; Avatar &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <table class="doc-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>src</code></td>
        <td><code>string</code></td>
        <td>—</td>
        <td>Image URL. When set, an &lt;img&gt; is rendered.</td>
      </tr>
      <tr>
        <td><code>alt</code></td>
        <td><code>string</code></td>
        <td>—</td>
        <td>Alt text for the image. Falls back to <code>name</code> when omitted (for a11y when src is set).</td>
      </tr>
      <tr>
        <td><code>name</code></td>
        <td><code>string</code></td>
        <td>—</td>
        <td>Used to derive initials and the aria-label when there is no image, and as the image alt fallback.</td>
      </tr>
      <tr>
        <td><code>size</code></td>
        <td><code>AvatarSize</code></td>
        <td><code>'md'</code></td>
        <td></td>
      </tr>
      <tr>
        <td><code>shape</code></td>
        <td><code>AvatarShape</code></td>
        <td><code>'circle'</code></td>
        <td></td>
      </tr>
    </tbody>
  </table>
</BaseLayout>
