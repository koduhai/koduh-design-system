---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Playground from '../../components/playground/Playground';
import CardDemo from '../../components/demos/CardDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Card" description="(+ `CardHeader` / `CardBody` / `CardFooter` slots)">
  <p class="doc-eyebrow">Data display &amp; feedback</p>
  <h1>Card</h1>
  <p class="doc-lede">(+ <code>CardHeader</code> / <code>CardBody</code> / <code>CardFooter</code> slots).</p>

  <p>Also exported from this module: <code>CardHeader</code>, <code>CardBody</code>, <code>CardFooter</code>.</p>
  <h2>Playground</h2>
  <Playground client:visible name="Card" />

  <h2>Examples</h2>
  <CardDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; Card, CardHeader, CardBody, CardFooter &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <table class="doc-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>variant</code></td>
        <td><code>CardVariant</code></td>
        <td><code>'outline'</code></td>
        <td>Surface style.</td>
      </tr>
      <tr>
        <td><code>padding</code></td>
        <td><code>CardPadding</code></td>
        <td><code>'md'</code></td>
        <td>Inner padding scale.</td>
      </tr>
      <tr>
        <td><code>asChild</code></td>
        <td><code>boolean</code></td>
        <td>—</td>
        <td>Render the single child element instead of a &lt;div&gt;, merging Card props onto it.</td>
      </tr>
    </tbody>
  </table>
</BaseLayout>
