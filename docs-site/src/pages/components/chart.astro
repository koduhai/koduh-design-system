---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Playground from '../../components/playground/Playground';
import ChartDemo from '../../components/demos/ChartDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Chart" description="minimal line/bar chart with categorical palette tokens (#28)">
  <p class="doc-eyebrow">Data display &amp; feedback</p>
  <h1>Chart</h1>
  <p class="doc-lede">minimal line/bar chart with categorical palette tokens (#28).</p>

  <h2>Playground</h2>
  <Playground client:visible name="Chart" />

  <h2>Examples</h2>
  <ChartDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; Chart &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <table class="doc-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>series</code></td>
        <td><code>ChartSeries[]</code></td>
        <td><em>required</em></td>
        <td>One or more data series.</td>
      </tr>
      <tr>
        <td><code>type</code></td>
        <td><code>ChartType</code></td>
        <td><code>'line'</code></td>
        <td>Render style.</td>
      </tr>
      <tr>
        <td><code>categories</code></td>
        <td><code>string[]</code></td>
        <td>—</td>
        <td>X-axis category labels, aligned by index with each series' data.</td>
      </tr>
      <tr>
        <td><code>width</code></td>
        <td><code>number</code></td>
        <td><code>320</code></td>
        <td>Chart width in px.</td>
      </tr>
      <tr>
        <td><code>height</code></td>
        <td><code>number</code></td>
        <td><code>180</code></td>
        <td>Chart height in px.</td>
      </tr>
      <tr>
        <td><code>showAxes</code></td>
        <td><code>boolean</code></td>
        <td><code>true</code></td>
        <td>Draw x/y axis lines.</td>
      </tr>
      <tr>
        <td><code>'aria-label'</code></td>
        <td><code>string</code></td>
        <td>—</td>
        <td>Accessible label. Falls back to a generated series summary.</td>
      </tr>
    </tbody>
  </table>
</BaseLayout>
