---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Playground from '../../components/playground/Playground';
import ChipDemo from '../../components/demos/ChipDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Chip" description="variants × tones, optional delete, `ReactNode` label">
  <p class="doc-eyebrow">Data display &amp; feedback</p>
  <h1>Chip</h1>
  <p class="doc-lede">variants × tones, optional delete, <code>ReactNode</code> label.</p>

  <p>Also exported from this module: <code>ReactNode</code>.</p>
  <h2>Playground</h2>
  <Playground client:visible name="Chip" />

  <h2>Examples</h2>
  <ChipDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; Chip, ReactNode &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <table class="doc-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>label</code></td>
        <td><code>ReactNode</code></td>
        <td><em>required</em></td>
        <td>Content shown in the chip. A string also seeds the delete button's default
accessible label (<code>Remove &lt;label&gt;</code>); for non-string labels pass <code>deleteLabel</code>.</td>
      </tr>
      <tr>
        <td><code>variant</code></td>
        <td><code>ChipVariant</code></td>
        <td><code>'solid'</code></td>
        <td>Visual style.</td>
      </tr>
      <tr>
        <td><code>tone</code></td>
        <td><code>ChipTone</code></td>
        <td><code>'neutral'</code></td>
        <td>Semantic color.</td>
      </tr>
      <tr>
        <td><code>size</code></td>
        <td><code>ChipSize</code></td>
        <td><code>'md'</code></td>
        <td></td>
      </tr>
      <tr>
        <td><code>icon</code></td>
        <td><code>ReactNode</code></td>
        <td>—</td>
        <td>Leading icon (decorative).</td>
      </tr>
      <tr>
        <td><code>onClick</code></td>
        <td><code>(event: MouseEvent&lt;HTMLElement&gt;) =&gt; void</code></td>
        <td>—</td>
        <td>Makes the chip a clickable button.</td>
      </tr>
      <tr>
        <td><code>onDelete</code></td>
        <td><code>(event: MouseEvent&lt;HTMLButtonElement&gt;) =&gt; void</code></td>
        <td>—</td>
        <td>Adds a labelled delete affordance. Receives the click event.</td>
      </tr>
      <tr>
        <td><code>deleteLabel</code></td>
        <td><code>string</code></td>
        <td><code>"Remove &lt;label&gt;"</code></td>
        <td>Accessible label for the delete button.</td>
      </tr>
    </tbody>
  </table>
</BaseLayout>
