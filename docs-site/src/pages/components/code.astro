---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Playground from '../../components/playground/Playground';
import CodeDemo from '../../components/demos/CodeDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Code" description="inline + block code surfaces (#32)">
  <p class="doc-eyebrow">Data display &amp; feedback</p>
  <h1>Code</h1>
  <p class="doc-lede">inline + block code surfaces (#32).</p>

  <p>Also exported from this module: <code>CodeBlock</code>.</p>
  <h2>Playground</h2>
  <Playground client:visible name="Code" />

  <h2>Examples</h2>
  <CodeDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; Code, CodeBlock &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <table class="doc-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>children</code></td>
        <td><code>ReactNode</code></td>
        <td><em>required</em></td>
        <td>Inline code content.</td>
      </tr>
    </tbody>
  </table>
</BaseLayout>
