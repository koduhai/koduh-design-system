---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Playground from '../../components/playground/Playground';
import CollapsibleDemo from '../../components/demos/CollapsibleDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Collapsible" description="single expandable region (#32)">
  <p class="doc-eyebrow">Layout &amp; primitives</p>
  <h1>Collapsible</h1>
  <p class="doc-lede">single expandable region (#32).</p>

  <h2>Playground</h2>
  <Playground client:visible name="Collapsible" />

  <h2>Examples</h2>
  <CollapsibleDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; Collapsible &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <table class="doc-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>trigger</code></td>
        <td><code>ReactNode</code></td>
        <td><em>required</em></td>
        <td>Content rendered inside the disclosure trigger button.</td>
      </tr>
      <tr>
        <td><code>children</code></td>
        <td><code>ReactNode</code></td>
        <td><em>required</em></td>
        <td>Content revealed when expanded.</td>
      </tr>
      <tr>
        <td><code>open</code></td>
        <td><code>boolean</code></td>
        <td>—</td>
        <td>Controlled open state.</td>
      </tr>
      <tr>
        <td><code>defaultOpen</code></td>
        <td><code>boolean</code></td>
        <td><code>false</code></td>
        <td>Initial open state when uncontrolled.</td>
      </tr>
      <tr>
        <td><code>onOpenChange</code></td>
        <td><code>(open: boolean) =&gt; void</code></td>
        <td>—</td>
        <td>Fires with the new open state on toggle.</td>
      </tr>
      <tr>
        <td><code>disabled</code></td>
        <td><code>boolean</code></td>
        <td>—</td>
        <td>Disables the trigger; the panel cannot be toggled while disabled.</td>
      </tr>
    </tbody>
  </table>
</BaseLayout>
