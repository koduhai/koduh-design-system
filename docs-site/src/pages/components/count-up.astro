---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Playground from '../../components/playground/Playground';
import CountUpDemo from '../../components/demos/CountUpDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="CountUp" description="animated count-up to target, honors reduced motion (#tailwind)">
  <p class="doc-eyebrow">Data display &amp; feedback</p>
  <h1>CountUp</h1>
  <p class="doc-lede">animated count-up to target, honors reduced motion (#tailwind).</p>

  <h2>Playground</h2>
  <Playground client:visible name="CountUp" />

  <h2>Examples</h2>
  <CountUpDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; CountUp &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <table class="doc-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>value</code></td>
        <td><code>number</code></td>
        <td><em>required</em></td>
        <td>Target value to animate to.</td>
      </tr>
      <tr>
        <td><code>from</code></td>
        <td><code>number</code></td>
        <td><code>0</code></td>
        <td>Starting value for the first animation.</td>
      </tr>
      <tr>
        <td><code>duration</code></td>
        <td><code>number</code></td>
        <td><code>800</code></td>
        <td>Animation duration in ms. <code>0</code> renders instantly.</td>
      </tr>
      <tr>
        <td><code>decimals</code></td>
        <td><code>number</code></td>
        <td><code>0</code></td>
        <td>Fixed decimal places when no <code>format</code> is given.</td>
      </tr>
      <tr>
        <td><code>format</code></td>
        <td><code>(n: number) =&gt; string</code></td>
        <td>—</td>
        <td>Custom formatter (e.g. currency/percent). Overrides <code>decimals</code>.</td>
      </tr>
    </tbody>
  </table>
</BaseLayout>
