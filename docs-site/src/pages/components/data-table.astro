---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DataTableDemo from '../../components/demos/DataTableDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="DataTable" description="stateful Table orchestrator: pagination, search, per-column filters, row selection, row expansion, column resize, server-side `manual` hook, opt-in row virtualization (#9/#30/#37)">
  <p class="doc-eyebrow">Data display &amp; feedback</p>
  <h1>DataTable</h1>
  <p class="doc-lede">stateful Table orchestrator: pagination, search, per-column filters, row selection, row expansion, column resize, server-side <code>manual</code> hook, opt-in row virtualization (#9/#30/#37).</p>

  <h2>Examples</h2>
  <DataTableDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; DataTable &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <p>
    The props for <code>DataTable</code> are defined as a union type, so they don't
    reduce to a single table. See the exported <code>DataTableProps</code> type and the
    <a href="https://github.com/koduhai/koduh-design-system/blob/main/src/components/DataTable/DataTable.tsx">source</a>.
  </p>
</BaseLayout>
