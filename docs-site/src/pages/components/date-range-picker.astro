---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Playground from '../../components/playground/Playground';
import DateRangePickerDemo from '../../components/demos/DateRangePickerDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="DateRangePicker" description="two-field range input over the range calendar (#42)">
  <p class="doc-eyebrow">Form controls</p>
  <h1>DateRangePicker</h1>
  <p class="doc-lede">two-field range input over the range calendar (#42).</p>

  <h2>Playground</h2>
  <Playground client:visible name="DateRangePicker" />

  <h2>Examples</h2>
  <DateRangePickerDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; DateRangePicker &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <table class="doc-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>value</code></td>
        <td><code>DateRange</code></td>
        <td>—</td>
        <td>Controlled selected range.</td>
      </tr>
      <tr>
        <td><code>defaultValue</code></td>
        <td><code>DateRange</code></td>
        <td>—</td>
        <td>Initial selected range when uncontrolled.</td>
      </tr>
      <tr>
        <td><code>onChange</code></td>
        <td><code>(range: DateRange) =&gt; void</code></td>
        <td>—</td>
        <td>Fires whenever an endpoint changes (start-only ranges report <code>end: null</code>).</td>
      </tr>
      <tr>
        <td><code>min</code></td>
        <td><code>Date</code></td>
        <td>—</td>
        <td>Earliest selectable date (inclusive).</td>
      </tr>
      <tr>
        <td><code>max</code></td>
        <td><code>Date</code></td>
        <td>—</td>
        <td>Latest selectable date (inclusive).</td>
      </tr>
      <tr>
        <td><code>size</code></td>
        <td><code>DateRangePickerSize</code></td>
        <td><code>'md'</code></td>
        <td></td>
      </tr>
      <tr>
        <td><code>disabled</code></td>
        <td><code>boolean</code></td>
        <td>—</td>
        <td>Disables the inputs and trigger.</td>
      </tr>
      <tr>
        <td><code>error</code></td>
        <td><code>boolean</code></td>
        <td>—</td>
        <td>Puts the control in the error state.</td>
      </tr>
      <tr>
        <td><code>required</code></td>
        <td><code>boolean</code></td>
        <td>—</td>
        <td>Marks the field required.</td>
      </tr>
      <tr>
        <td><code>label</code></td>
        <td><code>ReactNode</code></td>
        <td>—</td>
        <td>Visible label. Omit it (and wrap the control in a <code>&lt;FormField&gt;</code>) to defer the
label and aria wiring to the field.</td>
      </tr>
      <tr>
        <td><code>startPlaceholder</code></td>
        <td><code>string</code></td>
        <td><code>`dateRangePicker</code></td>
        <td>Placeholder for the start field. startPlaceholder`.</td>
      </tr>
      <tr>
        <td><code>endPlaceholder</code></td>
        <td><code>string</code></td>
        <td><code>`dateRangePicker</code></td>
        <td>Placeholder for the end field. endPlaceholder`.</td>
      </tr>
      <tr>
        <td><code>startLabel</code></td>
        <td><code>string</code></td>
        <td><code>`dateRangePicker</code></td>
        <td>Accessible name for the start field. startLabel`.</td>
      </tr>
      <tr>
        <td><code>endLabel</code></td>
        <td><code>string</code></td>
        <td><code>`dateRangePicker</code></td>
        <td>Accessible name for the end field. endLabel`.</td>
      </tr>
      <tr>
        <td><code>locale</code></td>
        <td><code>string</code></td>
        <td>—</td>
        <td>BCP 47 locale for the formatted values and the calendar.</td>
      </tr>
      <tr>
        <td><code>triggerLabel</code></td>
        <td><code>string</code></td>
        <td><code>`datePicker</code></td>
        <td>Accessible label for the calendar trigger button. triggerLabel`.</td>
      </tr>
      <tr>
        <td><code>className</code></td>
        <td><code>string</code></td>
        <td>—</td>
        <td>Class applied to the root wrapper.</td>
      </tr>
      <tr>
        <td><code>id</code></td>
        <td><code>string</code></td>
        <td>—</td>
        <td>Base id for the control; label/calendar ids derive from it.</td>
      </tr>
    </tbody>
  </table>
</BaseLayout>
