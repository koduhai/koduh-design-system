---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Playground from '../../components/playground/Playground';
import DescriptionListDemo from '../../components/demos/DescriptionListDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="DescriptionList" description="`&lt;dl&gt;` key-value primitive">
  <p class="doc-eyebrow">Data display &amp; feedback</p>
  <h1>DescriptionList</h1>
  <p class="doc-lede"><code>&lt;dl&gt;</code> key-value primitive.</p>

  <h2>Playground</h2>
  <Playground client:visible name="DescriptionList" />

  <h2>Examples</h2>
  <DescriptionListDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; DescriptionList &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <table class="doc-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>items</code></td>
        <td><code>DescriptionItem[]</code></td>
        <td><em>required</em></td>
        <td></td>
      </tr>
      <tr>
        <td><code>termWidth</code></td>
        <td><code>string</code></td>
        <td><code>'max-content'</code></td>
        <td>Fixed width of the term column.</td>
      </tr>
      <tr>
        <td><code>gap</code></td>
        <td><code>SpaceToken</code></td>
        <td><code>3</code></td>
        <td>Row gap (space token).</td>
      </tr>
    </tbody>
  </table>
</BaseLayout>
