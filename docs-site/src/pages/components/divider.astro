---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Playground from '../../components/playground/Playground';
import DividerDemo from '../../components/demos/DividerDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Divider" description="Divider component">
  <p class="doc-eyebrow">Layout &amp; primitives</p>
  <h1>Divider</h1>
  <p class="doc-lede">Part of the Layout &amp; primitives set.</p>

  <h2>Playground</h2>
  <Playground client:visible name="Divider" />

  <h2>Examples</h2>
  <DividerDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; Divider &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <table class="doc-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>orientation</code></td>
        <td><code>'horizontal' | 'vertical'</code></td>
        <td><code>'horizontal'</code></td>
        <td></td>
      </tr>
      <tr>
        <td><code>children</code></td>
        <td><code>ReactNode</code></td>
        <td>—</td>
        <td>Optional centered label (horizontal only). When present, the divider is decorative (role="presentation").</td>
      </tr>
      <tr>
        <td><code>inset</code></td>
        <td><code>boolean</code></td>
        <td>—</td>
        <td>Indent the rule from the start edge (useful inside lists/menus).</td>
      </tr>
    </tbody>
  </table>
</BaseLayout>
