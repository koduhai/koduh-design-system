---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Playground from '../../components/playground/Playground';
import EmptyStateDemo from '../../components/demos/EmptyStateDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="EmptyState" description="EmptyState component">
  <p class="doc-eyebrow">Data display &amp; feedback</p>
  <h1>EmptyState</h1>
  <p class="doc-lede">Part of the Data display &amp; feedback set.</p>

  <h2>Playground</h2>
  <Playground client:visible name="EmptyState" />

  <h2>Examples</h2>
  <EmptyStateDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; EmptyState &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <table class="doc-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>icon</code></td>
        <td><code>ReactNode</code></td>
        <td>—</td>
        <td>Decorative illustration or icon shown above the title.</td>
      </tr>
      <tr>
        <td><code>title</code></td>
        <td><code>ReactNode</code></td>
        <td><em>required</em></td>
        <td>Heading text. Required.</td>
      </tr>
      <tr>
        <td><code>description</code></td>
        <td><code>ReactNode</code></td>
        <td>—</td>
        <td>Supporting copy shown below the title.</td>
      </tr>
      <tr>
        <td><code>action</code></td>
        <td><code>ReactNode</code></td>
        <td>—</td>
        <td>Call-to-action — pass a real &lt;Button&gt;/&lt;a&gt;.</td>
      </tr>
      <tr>
        <td><code>headingLevel</code></td>
        <td><code>HeadingLevel</code></td>
        <td><code>2</code></td>
        <td>Semantic heading level for the title.</td>
      </tr>
    </tbody>
  </table>
</BaseLayout>
