---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Playground from '../../components/playground/Playground';
import HeadingDemo from '../../components/demos/HeadingDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Heading" description="semantic `level` decoupled from visual `size`">
  <p class="doc-eyebrow">Typography</p>
  <h1>Heading</h1>
  <p class="doc-lede">semantic <code>level</code> decoupled from visual <code>size</code>.</p>

  <h2>Playground</h2>
  <Playground client:visible name="Heading" />

  <h2>Examples</h2>
  <HeadingDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; Heading &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <table class="doc-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>level</code></td>
        <td><code>HeadingLevel</code></td>
        <td><em>required</em></td>
        <td>Semantic level — renders &lt;h1&gt;..&lt;h6&gt;.</td>
      </tr>
      <tr>
        <td><code>size</code></td>
        <td><code>HeadingSize</code></td>
        <td>—</td>
        <td>Visual size; defaults from <code>level</code>.</td>
      </tr>
      <tr>
        <td><code>weight</code></td>
        <td><code>HeadingWeight</code></td>
        <td>—</td>
        <td></td>
      </tr>
      <tr>
        <td><code>leading</code></td>
        <td><code>HeadingLeading</code></td>
        <td><code>`'tight'`</code></td>
        <td>Line height.</td>
      </tr>
    </tbody>
  </table>
</BaseLayout>
