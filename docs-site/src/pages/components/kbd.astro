---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Playground from '../../components/playground/Playground';
import KbdDemo from '../../components/demos/KbdDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Kbd" description="keyboard-key chip (#32)">
  <p class="doc-eyebrow">Data display &amp; feedback</p>
  <h1>Kbd</h1>
  <p class="doc-lede">keyboard-key chip (#32).</p>

  <h2>Playground</h2>
  <Playground client:visible name="Kbd" />

  <h2>Examples</h2>
  <KbdDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; Kbd &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <table class="doc-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>children</code></td>
        <td><code>ReactNode</code></td>
        <td><em>required</em></td>
        <td>The key label(s) to display.</td>
      </tr>
      <tr>
        <td><code>size</code></td>
        <td><code>KbdSize</code></td>
        <td><code>'md'</code></td>
        <td></td>
      </tr>
    </tbody>
  </table>
</BaseLayout>
