---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Playground from '../../components/playground/Playground';
import MeterDemo from '../../components/demos/MeterDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Meter" description="`role=&quot;meter&quot;` measurement gauge with threshold tones (#43)">
  <p class="doc-eyebrow">Data display &amp; feedback</p>
  <h1>Meter</h1>
  <p class="doc-lede"><code>role="meter"</code> measurement gauge with threshold tones (#43).</p>

  <h2>Playground</h2>
  <Playground client:visible name="Meter" />

  <h2>Examples</h2>
  <MeterDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; Meter &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <table class="doc-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>value</code></td>
        <td><code>number</code></td>
        <td><em>required</em></td>
        <td>The current numeric measurement.</td>
      </tr>
      <tr>
        <td><code>min</code></td>
        <td><code>number</code></td>
        <td>—</td>
        <td>Lower bound. Default 0.</td>
      </tr>
      <tr>
        <td><code>max</code></td>
        <td><code>number</code></td>
        <td>—</td>
        <td>Upper bound. Default 100.</td>
      </tr>
      <tr>
        <td><code>low</code></td>
        <td><code>number</code></td>
        <td>—</td>
        <td>Upper bound of the low (often "poor") range.</td>
      </tr>
      <tr>
        <td><code>high</code></td>
        <td><code>number</code></td>
        <td>—</td>
        <td>Lower bound of the high (often "poor") range.</td>
      </tr>
      <tr>
        <td><code>optimum</code></td>
        <td><code>number</code></td>
        <td>—</td>
        <td>The optimal value; its position relative to <code>low</code>/<code>high</code> determines which band is "good".</td>
      </tr>
      <tr>
        <td><code>label</code></td>
        <td><code>ReactNode</code></td>
        <td>—</td>
        <td>Accessible name; rendered and wired via aria-labelledby when provided.</td>
      </tr>
      <tr>
        <td><code>formatValue</code></td>
        <td><code>(value: number) =&gt; string</code></td>
        <td>—</td>
        <td>Formats <code>value</code> for <code>aria-valuetext</code> and the optional visible readout.</td>
      </tr>
      <tr>
        <td><code>size</code></td>
        <td><code>MeterSize</code></td>
        <td>—</td>
        <td>Track thickness. Default 'md'.</td>
      </tr>
      <tr>
        <td><code>showValue</code></td>
        <td><code>boolean</code></td>
        <td>—</td>
        <td>Render the formatted value as visible text. Default false.</td>
      </tr>
    </tbody>
  </table>
</BaseLayout>
