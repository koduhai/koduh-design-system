---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Playground from '../../components/playground/Playground';
import PasswordInputDemo from '../../components/demos/PasswordInputDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="PasswordInput" description="labelled password input with show/hide toggle (#tailwind)">
  <p class="doc-eyebrow">Form controls</p>
  <h1>PasswordInput</h1>
  <p class="doc-lede">labelled password input with show/hide toggle (#tailwind).</p>

  <h2>Playground</h2>
  <Playground client:visible name="PasswordInput" />

  <h2>Examples</h2>
  <PasswordInputDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; PasswordInput &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <table class="doc-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>label</code></td>
        <td><code>ReactNode</code></td>
        <td>—</td>
        <td>Visible label, associated with the input. Or wrap in a <code>&lt;FormField&gt;</code>.</td>
      </tr>
      <tr>
        <td><code>value</code></td>
        <td><code>string</code></td>
        <td>—</td>
        <td>Controlled value.</td>
      </tr>
      <tr>
        <td><code>defaultValue</code></td>
        <td><code>string</code></td>
        <td>—</td>
        <td>Initial value when uncontrolled.</td>
      </tr>
      <tr>
        <td><code>onChange</code></td>
        <td><code>(value: string, event: ChangeEvent&lt;HTMLInputElement&gt;) =&gt; void</code></td>
        <td>—</td>
        <td>Fires on every keystroke with the new value (and the native event).</td>
      </tr>
      <tr>
        <td><code>helperText</code></td>
        <td><code>ReactNode</code></td>
        <td>—</td>
        <td>Hint shown below the field. Hidden when an error is shown.</td>
      </tr>
      <tr>
        <td><code>error</code></td>
        <td><code>boolean</code></td>
        <td>—</td>
        <td>Puts the field in the error state (aria-invalid).</td>
      </tr>
      <tr>
        <td><code>errorText</code></td>
        <td><code>ReactNode</code></td>
        <td>—</td>
        <td>Message shown below the field when <code>error</code> is set; replaces helperText.</td>
      </tr>
      <tr>
        <td><code>size</code></td>
        <td><code>PasswordInputSize</code></td>
        <td><code>'md'</code></td>
        <td></td>
      </tr>
      <tr>
        <td><code>density</code></td>
        <td><code>Density</code></td>
        <td>—</td>
        <td>Field density; omit to inherit a <code>data-density</code> ancestor.</td>
      </tr>
    </tbody>
  </table>
</BaseLayout>
