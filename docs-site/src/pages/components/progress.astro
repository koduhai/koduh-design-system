---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Playground from '../../components/playground/Playground';
import ProgressDemo from '../../components/demos/ProgressDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Progress" description="bar with shared tone vocab">
  <p class="doc-eyebrow">Data display &amp; feedback</p>
  <h1>Progress</h1>
  <p class="doc-lede">bar with shared tone vocab.</p>

  <h2>Playground</h2>
  <Playground client:visible name="Progress" />

  <h2>Examples</h2>
  <ProgressDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; Progress &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <table class="doc-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>value</code></td>
        <td><code>number</code></td>
        <td>—</td>
        <td>Determinate progress amount. Omit for an indeterminate bar.</td>
      </tr>
      <tr>
        <td><code>max</code></td>
        <td><code>number</code></td>
        <td>—</td>
        <td>Upper bound of <code>value</code>. Default 100.</td>
      </tr>
      <tr>
        <td><code>label</code></td>
        <td><code>string</code></td>
        <td>—</td>
        <td>Accessible name; also shown when <code>showValue</code> is set.</td>
      </tr>
      <tr>
        <td><code>showValue</code></td>
        <td><code>boolean</code></td>
        <td>—</td>
        <td>Render a visible label row with the percentage. Default false.</td>
      </tr>
      <tr>
        <td><code>size</code></td>
        <td><code>ProgressSize</code></td>
        <td>—</td>
        <td>Track thickness. Default 'md'.</td>
      </tr>
      <tr>
        <td><code>tone</code></td>
        <td><code>ProgressTone</code></td>
        <td>—</td>
        <td>Fill color. Default 'primary'.</td>
      </tr>
    </tbody>
  </table>
</BaseLayout>
