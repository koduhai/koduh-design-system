---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Playground from '../../components/playground/Playground';
import StatusBadgeDemo from '../../components/demos/StatusBadgeDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="StatusBadge" description="text + dot + color (never color-only)">
  <p class="doc-eyebrow">Data display &amp; feedback</p>
  <h1>StatusBadge</h1>
  <p class="doc-lede">text + dot + color (never color-only).</p>

  <h2>Playground</h2>
  <Playground client:visible name="StatusBadge" />

  <h2>Examples</h2>
  <StatusBadgeDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; StatusBadge &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <table class="doc-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>status</code></td>
        <td><code>StatusBadgeStatus</code></td>
        <td><em>required</em></td>
        <td>Semantic status. Drives color and the dot.</td>
      </tr>
      <tr>
        <td><code>label</code></td>
        <td><code>string</code></td>
        <td><em>required</em></td>
        <td>Text label — always rendered so color is never the only signal.</td>
      </tr>
      <tr>
        <td><code>variant</code></td>
        <td><code>StatusBadgeVariant</code></td>
        <td><code>'subtle'</code></td>
        <td>Visual style.</td>
      </tr>
    </tbody>
  </table>
</BaseLayout>
