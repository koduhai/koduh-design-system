---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Playground from '../../components/playground/Playground';
import SwitchDemo from '../../components/demos/SwitchDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Switch" description="Switch component">
  <p class="doc-eyebrow">Form controls</p>
  <h1>Switch</h1>
  <p class="doc-lede">Part of the Form controls set.</p>

  <h2>Playground</h2>
  <Playground client:visible name="Switch" />

  <h2>Examples</h2>
  <SwitchDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; Switch &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <table class="doc-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>label</code></td>
        <td><code>ReactNode</code></td>
        <td>—</td>
        <td>Label rendered beside the control and used as the accessible name.</td>
      </tr>
      <tr>
        <td><code>checked</code></td>
        <td><code>boolean</code></td>
        <td>—</td>
        <td>Controlled checked state.</td>
      </tr>
      <tr>
        <td><code>defaultChecked</code></td>
        <td><code>boolean</code></td>
        <td>—</td>
        <td>Initial checked state when uncontrolled.</td>
      </tr>
      <tr>
        <td><code>onChange</code></td>
        <td><code>(checked: boolean, event: React.ChangeEvent&lt;HTMLInputElement&gt;) =&gt; void</code></td>
        <td>—</td>
        <td>Fires on toggle with the new checked value (and the native event).</td>
      </tr>
      <tr>
        <td><code>size</code></td>
        <td><code>SwitchSize</code></td>
        <td><code>'md'</code></td>
        <td></td>
      </tr>
      <tr>
        <td><code>error</code></td>
        <td><code>boolean</code></td>
        <td>—</td>
        <td>Puts the control in the error state (aria-invalid). Ignored inside a FormField, which drives invalid from validation.</td>
      </tr>
    </tbody>
  </table>
</BaseLayout>
