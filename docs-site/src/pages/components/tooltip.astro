---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Playground from '../../components/playground/Playground';
import TooltipDemo from '../../components/demos/TooltipDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Tooltip" description="Tooltip component">
  <p class="doc-eyebrow">Overlays &amp; floating</p>
  <h1>Tooltip</h1>
  <p class="doc-lede">Part of the Overlays &amp; floating set.</p>

  <h2>Playground</h2>
  <Playground client:visible name="Tooltip" />

  <h2>Examples</h2>
  <TooltipDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; Tooltip &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <table class="doc-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>content</code></td>
        <td><code>ReactNode</code></td>
        <td><em>required</em></td>
        <td>Tooltip text/content.</td>
      </tr>
      <tr>
        <td><code>placement</code></td>
        <td><code>PopoverPlacement</code></td>
        <td><code>'top'</code></td>
        <td>Anchored placement.</td>
      </tr>
      <tr>
        <td><code>delay</code></td>
        <td><code>number</code></td>
        <td><code>200</code></td>
        <td>Open/close delay in ms.</td>
      </tr>
      <tr>
        <td><code>className</code></td>
        <td><code>string</code></td>
        <td>—</td>
        <td>Extra class on the tooltip panel.</td>
      </tr>
      <tr>
        <td><code>children</code></td>
        <td><code>ReactElement&lt;HTMLAttributes&lt;HTMLElement&gt;&gt;</code></td>
        <td><em>required</em></td>
        <td>The single trigger element.</td>
      </tr>
    </tbody>
  </table>
</BaseLayout>
