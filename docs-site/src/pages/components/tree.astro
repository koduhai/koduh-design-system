---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Playground from '../../components/playground/Playground';
import TreeDemo from '../../components/demos/TreeDemo';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Tree" description="keyboard-navigable tree (#32)">
  <p class="doc-eyebrow">Data display &amp; feedback</p>
  <h1>Tree</h1>
  <p class="doc-lede">keyboard-navigable tree (#32).</p>

  <h2>Playground</h2>
  <Playground client:visible name="Tree" />

  <h2>Examples</h2>
  <TreeDemo client:visible />

  <h2>Import</h2>
  <p><code>import &#123; Tree &#125; from '@koduhai/design-system';</code></p>

  <h2>Props</h2>
  <table class="doc-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>nodes</code></td>
        <td><code>TreeNode[]</code></td>
        <td><em>required</em></td>
        <td>The hierarchy to render.</td>
      </tr>
      <tr>
        <td><code>defaultExpanded</code></td>
        <td><code>string[]</code></td>
        <td>—</td>
        <td>Initially expanded parent ids when uncontrolled.</td>
      </tr>
      <tr>
        <td><code>expanded</code></td>
        <td><code>string[]</code></td>
        <td>—</td>
        <td>Controlled set of expanded parent ids.</td>
      </tr>
      <tr>
        <td><code>onExpandedChange</code></td>
        <td><code>(ids: string[]) =&gt; void</code></td>
        <td>—</td>
        <td>Fires with the next set of expanded ids.</td>
      </tr>
      <tr>
        <td><code>defaultSelectedId</code></td>
        <td><code>string</code></td>
        <td>—</td>
        <td>Initially selected node id when uncontrolled.</td>
      </tr>
      <tr>
        <td><code>selectedId</code></td>
        <td><code>string</code></td>
        <td>—</td>
        <td>Controlled selected node id.</td>
      </tr>
      <tr>
        <td><code>onSelect</code></td>
        <td><code>(id: string) =&gt; void</code></td>
        <td>—</td>
        <td>Fires with a node id when it is selected.</td>
      </tr>
    </tbody>
  </table>
</BaseLayout>
